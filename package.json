{
  "name": "platemap-studio",
  "productName": "PlateMap Studio",
  "version": "0.1.2",
  "description": "Professional plate map designer for screening and Cell Painting",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "be.vub.livr.platemapstudio",
    "productName": "PlateMap Studio",
    "artifactName": "PlateMap-Studio-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "fileAssociations": [
      {
        "ext": "platemap",
        "name": "PlateMap project",
        "role": "Editor"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "icon": "build/icon.png",
      "maintainer": "LIVR-VUB <arkajyoti.sarkar@vub.be>",
      "synopsis": "Plate map designer for screening and Cell Painting",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "PlateMap-Studio-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "PlateMap-Studio-${version}-windows-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "PlateMap-Studio-${version}-mac-${arch}.${ext}"
    },
    "publish": null
  },
  "dependencies": {
    "immer": "^11.1.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LIVR-VUB/Platemap-studio.git"
  },
  "author": "Arkajyoti Sarkar <arkajyoti.sarkar@vub.be>",
  "license": "MIT",
  "homepage": "https://github.com/LIVR-VUB/Platemap-studio",
  "desktopName": "platemap-studio.desktop"
}
